<Window x:Class="LensTool.UI.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LensTool — выделение области"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <!-- Frozen screenshot of this monitor: 1 image pixel = 1 physical pixel. -->
        <Image x:Name="BackgroundImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Dims everything except the selected region. -->
        <Path x:Name="DimPath" Fill="#73000000" />

        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="SelectionBorder"
                       Stroke="#FF38BDF8"
                       StrokeThickness="1"
                       Visibility="Collapsed" />
            <Border x:Name="SizeLabel"
                    Background="#D9000000"
                    CornerRadius="3"
                    Padding="6,2"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>
        </Canvas>

        <Border x:Name="HintPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,32,0,0"
                Padding="14,8"
                CornerRadius="6"
                Background="#E6202020"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="14" />
        </Border>
    </Grid>
</Window>
